{
  "name": "sandbox-angular15-example",
  "private": true,
  "description": "An Angular 15 host (the versions Envizom runs) using <sbx-artifact> to run plain JS, React and Svelte artifacts.",
  "scripts": {
    "build": "ng build --configuration production",
    "start": "ng serve",
    "build:e2e": "ng build --configuration production --base-href /examples/angular15/dist/"
  },
  "dependencies": {
    "@angular/common": "~15.2.10",
    "@angular/compiler": "~15.2.10",
    "@angular/core": "~15.2.10",
    "@angular/platform-browser": "~15.2.10",
    "@panth977/sandbox": "file:../..",
    "rxjs": "~7.5.0",
    "tslib": "^2.6.2",
    "zone.js": "~0.12.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~15.2.11",
    "@angular/cli": "~15.2.11",
    "@angular/compiler-cli": "~15.2.10",
    "typescript": "~4.8.4",
    "@types/node": "18.11.18"
  },
  "overrides": {
    "@types/node": "18.11.18"
  }
}
