{
  "name": "@panth977/sandbox",
  "version": "0.3.1",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/mod.ts",
    "./host": "./src/host/mod.ts",
    "./svelte": "./src/host/svelte.ts",
    "./element": "./src/host/element.ts",
    "./bridge": "./src/bridge.ts",
    "./middleware": "./src/middleware.ts",
    "./protocol": "./src/protocol.ts",
    "./artifact": "./src/artifact/artifact.ts",
    "./stores": "./src/artifact/stores.ts",
    "./react": "./src/artifact/react.ts",
    "./ui": "./src/ui/index.ts",
    "./compiler": "./src/compiler/mod.ts",
    "./editor": "./src/editor/editor.ts",
    "./dev": "./src/dev/mod.ts",
    "./dev/language-worker": "./src/dev/language-worker.ts",
    "./compiler/worker": "./src/compiler/worker.ts",
    "./cli": "./src/compiler/cli.ts",
    "./server/node": "./server/ts/node.ts",
    "./server/deno": "./server/ts/deno.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "LICENSE",
      "server/ts/*.ts",
      "server/go/kits/js/peer.mjs",
      "server/go/kits/js/peer.d.ts"
    ],
    "exclude": [
      "src/**/*.test.ts"
    ]
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext",
      "deno.ns"
    ]
  },
  "fmt": {
    "lineWidth": 140
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "tasks": {
    "gen": "node scripts/gen.mjs",
    "check": "deno check src/",
    "test": "node --experimental-strip-types --no-warnings --test --test-timeout=10000 test/*.test.ts",
    "e2e": "node e2e/run.mjs",
    "build": "node scripts/build.mjs",
    "deps": "node scripts/check-deps.mjs",
    "ci": "node scripts/gen.mjs --check && node scripts/check-deps.mjs && deno check src/ server/ts/node.ts && deno task test && node scripts/build.mjs",
    "server:test": "cd server/go && go vet ./... && go test ./...",
    "server:e2e": "node --experimental-strip-types --no-warnings server/e2e/e2e.ts"
  },
  "nodeModulesDir": "none"
}
